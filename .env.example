# ── SearXNG ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
# Public URL of the SearXNG instance (used internally by SearXNG itself)
SEARXNG_BASE_URL=http://localhost:8080/

# ── RaiaSpace ────────────────────────────────────────────────
# Full origin of the frontend, no trailing slash, no path
RAIASPACE_FRONTEND_URL=https://search.example.com

# ── Domains & TLS ────────────────────────────────────────────
# Plain domain only — no scheme, no trailing slash, no path
DOMAIN_FRONTEND=search.example.com
LETSENCRYPT_EMAIL=you@example.com
